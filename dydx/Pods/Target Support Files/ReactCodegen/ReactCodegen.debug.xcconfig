OTHER_CPLUSPLUSFLAGS = $(inherited) -DFOLLY_NO_CONFIG -DFOLLY_MOBILE=1 -DFOLLY_USE_LIBCPP=1 -DFOLLY_CFG_NO_COROUTINES=1 -DFOLLY_HAVE_CLOCK_GETTIME=1 -Wno-comma -Wno-shorten-64-to-32 -Wno-documentation
OTHER_LDFLAGS = $(inherited) -framework "DoubleConversion" -framework "RCTTypeSafety" -framework "React" -framework "ReactCommon" -framework "React_Fabric" -framework "React_FabricImage" -framework "React_NativeModulesApple" -framework "React_RCTAppDelegate" -framework "React_debug" -framework "React_featureflags" -framework "React_graphics" -framework "React_rendererdebug" -framework "React_utils" -framework "UIKit" -framework "folly" -framework "glog" -framework "hermes" -framework "jsi" -framework "jsireact" -weak_framework "JavaScriptCore"
PODS_BUILD_DIR = ${BUILD_DIR}
PODS_CONFIGURATION_BUILD_DIR = ${PODS_BUILD_DIR}/$(CONFIGURATION)$(EFFECTIVE_PLATFORM_NAME)
PODS_DEVELOPMENT_LANGUAGE = ${DEVELOPMENT_LANGUAGE}
PODS_ROOT = ${SRCROOT}
PODS_TARGET_SRCROOT = ${PODS_ROOT}/../build/generated/ios
PODS_XCFRAMEWORKS_BUILD_DIR = $(PODS_CONFIGURATION_BUILD_DIR)/XCFrameworkIntermediates
PRODUCT_BUNDLE_IDENTIFIER = org.cocoapods.${PRODUCT_NAME:rfc1034identifier}
SKIP_INSTALL = YES
USE_RECURSIVE_SCRIPT_INPUTS_IN_SCRIPT_PHASES = YES
